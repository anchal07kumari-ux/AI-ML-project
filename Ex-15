
def unify(x, y, subs={}):
    if x == y:
        return subs

    if isinstance(x, str) and x.islower():
        subs[x] = y
        return subs

    if isinstance(y, str) and y.islower():
        subs[y] = x
        return subs

    return None


def resolution(c1, c2):
    for a in c1:
        for b in c2:
            if a[1] == b[1] and a[0] != b[0]:
                return c1 + c2
    return None


